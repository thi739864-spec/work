# Everything works with NO keys: the default "Flux (free)" and "Turbo (free)"
# models use Pollinations.ai anonymously (rate limited to ~1 image / 15s).
# Copy this file to .env.local and fill in any optional values below.

# Optional: free token from https://auth.pollinations.ai to lift the anonymous
# rate limit and remove watermarks.
POLLINATIONS_TOKEN=

# Optional: free Hugging Face access token (https://huggingface.co/settings/tokens)
# to unlock the "FLUX.1 schnell (Hugging Face)" model. Free monthly credits apply.
HF_TOKEN=
